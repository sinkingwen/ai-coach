# ===== 必填 =====
# 火山方舟 API Key（获取地址：https://console.volcengine.com/ark）
ARK_API_KEY=your_api_key_here

# ===== 可选（以下均有默认值，按需修改）=====

# 模型 / 推理接入点 ID（火山方舟控制台创建后获得）
ARK_MODEL=deepseek-v4-flash-260425

# 接口域名
ARK_HOST=ark.cn-beijing.volces.com

# 接口路径
ARK_PATH=/api/v3/responses

# 采样温度（0~2，越高越随机）
TEMPERATURE=0.6

# 请求超时（毫秒，Vercel Serverless 需小于等于 maxDuration×1000）
TIMEOUT_MS=60000

# 本地开发端口（仅 server.js 使用，Vercel 部署时忽略）
PORT=3000
