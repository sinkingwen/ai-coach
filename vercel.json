{
  "version": 2,
  "builds": [
    { "src": "api/chat.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/(.+)", "dest": "/public/$1" },
    { "src": "/", "dest": "/public/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
